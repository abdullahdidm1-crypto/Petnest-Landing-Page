{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/about-us", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact-us", "destination": "/contact.html" },
    { "source": "/grooming", "destination": "/grooming.html" },
    { "source": "/pet-grooming", "destination": "/grooming.html" },
    { "source": "/delhi-ncr", "destination": "/grooming.html" },
    { "source": "/pet-grooming/delhi-ncr", "destination": "/grooming.html" },
    { "source": "/pet-relocation", "destination": "/pet-relocation.html" },
    { "source": "/pet-relocation/by-train", "destination": "/pet-relocation-by-train.html" },
    { "source": "/pet-relocation/domestic", "destination": "/domestic-pet-transport.html" },
    { "source": "/pet-relocation/pet-courier-service", "destination": "/pet-courier-service.html" },
    { "source": "/pet-relocation/cost", "destination": "/pet-relocation-cost.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}